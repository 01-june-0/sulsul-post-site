{
  "site": "naver-post",
  "version": "2026.10.10-1",
  "verified": true,
  "selectors": {
    "container": { "css": [".se-main-container", "#viewTypeSelector", ".post_ct", "#postViewArea", ".se_component_wrap"] },
    "title": { "css": [".se-title-text", ".se-documentTitle", ".se_title", "h3.se_textarea", ".tit_h3"] },
    "component": { "css": [".se-component"] },
    "paragraph": { "css": [".se-text-paragraph"] },
    "sectionTitle": { "css": [".se-section-sectionTitle", ".se-sectionTitle"], "note": "a component that is one, or holds one (also quote, table, image, video, skip; research extract-post, 2026-10-10)" },
    "quote": { "css": [".se-quotation", ".se-section-quotation"] },
    "table": { "css": [".se-table", "table"] },
    "image": { "css": [".se-image-resource", ".se-module-image img", ".se_mediaImage", "[class*='se-image']", "[class*='se-sticker']"] },
    "video": { "css": [".se-video", ".se-oembed", ".se-component.se-video", "[class*='se-video']", "[class*='se-oembed']"] },
    "skip": { "css": ["[class*='horizontalLine']", "[class*='placesMap']"], "note": "components with no text to read (dividers, maps)" },
    "largeText": { "css": ["[class*='se-fs-fs2']", "[class*='se-fs-fs3']"], "note": "large font sizes: a short line in them reads as a heading" },
    "caption": { "css": [".se-caption", ".se_textarea.caption"] },
    "tags": { "css": [".post_tag a", ".wrap_tag a", "a[class*='tag']"] },
    "blogName": { "css": [".blog_name", ".nick", "[class*='blogger_name']", ".blog_author"] },
    "date": { "css": [".se_publishDate", ".blog_date", "[class*='publishDate']", "[class*='date']"] }
  },
  "texts": {
    "private": ["비공개", "접근 권한이 없"],
    "deleted": ["삭제되었거나", "존재하지 않는"],
    "blocked": ["자동입력 방지", "비정상적인 접근", "보안 문자"]
  }
}
